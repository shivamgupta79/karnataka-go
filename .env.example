# ════════════════════════════════════════════════════════════════════════════
#  KarnatakaGo — environment variable reference
#  Copy this file to apps/web/.env.local and fill in your values.
#  NEVER commit .env.local to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── AI (required for trip narration) ────────────────────────────────────────
# Option A — Portkey AI gateway (recommended, adds caching + analytics)
#   Get key: https://portkey.ai
PORTKEY_API_KEY=pt_live_...

# Option B — Direct Anthropic (used when PORTKEY_API_KEY is not set)
#   Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (required for auth, saved trips, chat, reviews) ────────────────
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Admin dashboard ──────────────────────────────────────────────────────────
# A strong random secret string — protects the /admin page
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your-strong-random-secret-here

# ── Optional: OR-Tools route optimiser ──────────────────────────────────────
# Run apps/optimizer locally: uvicorn main:app --port 8000
# Leave blank to use the built-in nearest-neighbour fallback (works fine)
OPTIMIZER_URL=http://localhost:8000

# ── Optional: public site URL (used in auth redirect links) ─────────────────
# Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Render deployment: set this to your Render app URL, e.g.:
# NEXT_PUBLIC_SITE_URL=https://karnataka-go-web.onrender.com

# ── Render: PORT is injected automatically — do NOT set this manually ────────
# Render sets PORT at runtime; `next start -p ${PORT:-3000}` reads it.
# Leave this line commented out in both local dev and Render dashboard.
# PORT=3000
